<Window
    x:Class="QuickMsiBuilder.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quick MSI Builder"
    Width="540"
    Height="640"
    MinWidth="500"
    MinHeight="560"
    Icon="Resources/dev.ico"
    PreviewKeyDown="OnWindowKeyDown"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickMsiBuilder.UI;component/Themes/Styles/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title bar strip, same 30px band the Add-in Manager uses  -->
        <Grid Grid.Row="0" Margin="10,6,10,0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Quick MSI Builder" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="10,6,10,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource FieldLabel}"
                    Text="Target DLL" />
                <TextBox
                    x:Name="txtDllPath"
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="25"
                    Margin="0,3"
                    IsReadOnly="True" />
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="70"
                    Height="25"
                    Margin="5,3,0,3"
                    Click="OnBrowseDll"
                    Content="Browse" />

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource FieldLabel}"
                    Text="Previous release" />
                <ComboBox
                    x:Name="cbHistory"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="25"
                    Margin="0,3"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnHistorySelected"
                    ToolTip="Settings recorded from earlier builds of this assembly" />
                <Button
                    x:Name="btnReuse"
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="70"
                    Height="25"
                    Margin="5,3,0,3"
                    Click="OnReuseHistory"
                    Content="Reuse"
                    IsEnabled="False" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    x:Name="txtHistoryHint"
                    Margin="0,0,0,4"
                    Style="{StaticResource HintText}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SectionHeader}"
                    Text="Package metadata" />

                <TextBlock
                    Grid.Row="4"
                    Style="{StaticResource FieldLabel}"
                    Text="Version" />
                <TextBox
                    x:Name="txtVersion"
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="25"
                    Margin="0,3"
                    Text="1.0.0"
                    ToolTip="MSI product version: major.minor.build" />

                <TextBlock
                    Grid.Row="5"
                    Style="{StaticResource FieldLabel}"
                    Text="Author" />
                <TextBox
                    x:Name="txtAuthor"
                    Grid.Row="5"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="25"
                    Margin="0,3" />

                <TextBlock
                    Grid.Row="6"
                    Style="{StaticResource FieldLabel}"
                    Text="Description" />
                <TextBox
                    x:Name="txtDescription"
                    Grid.Row="6"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="25"
                    Margin="0,3"
                    Text="Revit Add-in" />

                <TextBlock
                    Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SectionHeader}"
                    Text="Add-in entry points" />
                <Border
                    Grid.Row="8"
                    Grid.ColumnSpan="3"
                    Margin="0,3"
                    Padding="8,6"
                    BorderBrush="{DynamicResource TextBoxBorderBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtEntriesHint"
                            Margin="0,0,0,6"
                            Style="{StaticResource HintText}"
                            Text="Every command found in the assembly is packaged. Untick what you do not want." />
                        <ItemsControl x:Name="icEntries" MaxHeight="130">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,3"
                                        Content="{Binding DisplayName}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Only needed when the assembly declares no entry point at all  -->
                <TextBlock
                    x:Name="lblManualClass"
                    Grid.Row="9"
                    Style="{StaticResource FieldLabel}"
                    Text="Class name" />
                <TextBox
                    x:Name="txtManualClass"
                    Grid.Row="9"
                    Grid.Column="1"
                    Height="25"
                    Margin="0,3" />
                <ComboBox
                    x:Name="cbAddinType"
                    Grid.Row="9"
                    Grid.Column="2"
                    Width="110"
                    Height="25"
                    Margin="5,3,0,3">
                    <ComboBoxItem Content="Command" IsSelected="True" />
                    <ComboBoxItem Content="Application" />
                </ComboBox>

                <TextBlock
                    Grid.Row="10"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SectionHeader}"
                    Text="Revit versions" />

                <Border
                    Grid.Row="11"
                    Grid.ColumnSpan="3"
                    Padding="8,6"
                    BorderBrush="{DynamicResource TextBoxBorderBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource HintText}"
                            Text="Pick every Revit release the add-in should be installed for. One MSI covers them all." />
                        <ItemsControl x:Name="icRevitYears">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Width="72"
                                        Margin="0,3"
                                        Content="{Binding Year}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock
                    Grid.Row="12"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SectionHeader}"
                    Text="Cosmetics (optional)" />

                <Grid Grid.Row="13" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource FieldLabel}"
                        Text="Icon (.ico)" />
                    <TextBox
                        x:Name="txtIconPath"
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="25"
                        Margin="0,3" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Width="70"
                        Height="25"
                        Margin="5,3,0,3"
                        Click="OnBrowseIcon"
                        Content="Browse" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="3"
                        Width="60"
                        Height="25"
                        Margin="5,3,0,3"
                        Click="OnClearIcon"
                        Content="Clear" />

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource FieldLabel}"
                        Text="Background (.png)" />
                    <TextBox
                        x:Name="txtBgPath"
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="25"
                        Margin="0,3" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="70"
                        Height="25"
                        Margin="5,3,0,3"
                        Click="OnBrowseBg"
                        Content="Browse" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="3"
                        Width="60"
                        Height="25"
                        Margin="5,3,0,3"
                        Click="OnClearBg"
                        Content="Clear" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource HintText}"
                        Text="Leave both empty to use the default installer look." />
                </Grid>
            </Grid>
        </ScrollViewer>

        <TextBlock
            x:Name="txtStatus"
            Grid.Row="2"
            Margin="10,10,10,0"
            MaxHeight="70"
            Style="{StaticResource HintText}" />

        <Grid Grid.Row="3" Margin="10,8,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Width="90"
                Height="28"
                Click="OnOpenLog"
                Content="Open log"
                ToolTip="Open the NLog file written by the builder" />
            <Button
                x:Name="btnBuild"
                Grid.Column="2"
                Width="130"
                Height="28"
                Click="OnBuildMsi"
                Content="Build MSI"
                IsDefault="True" />
        </Grid>
    </Grid>
</Window>
